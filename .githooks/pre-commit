#!/bin/sh
# 每次提交前自动扫描 posts/*.md 重新生成 posts/index.json
root="$(dirname "$0")/.."
if command -v node >/dev/null 2>&1; then
    NODE=node
elif [ -f "/c/develop/nvm4w/nodejs/node.exe" ]; then
    NODE="/c/develop/nvm4w/nodejs/node.exe"
else
    echo "pre-commit: node 未找到，跳过 index.json 生成" >&2
    exit 0
fi
"$NODE" "$root/tools/gen-index.js" || exit 1
git add "$root/posts/index.json"
